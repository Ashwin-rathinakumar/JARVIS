# JARVIS Configuration

# Server Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# LLM Provider Configuration
JARVIS_LLM_PROVIDER=nemotron
JARVIS_LLM_BASE_URL=http://127.0.0.1:8000/v1
JARVIS_LLM_MODEL=nvidia/nemotron
JARVIS_LLM_TIMEOUT=45
JARVIS_LLM_API_KEY=
JARVIS_LLM_TEMPERATURE=0.3
JARVIS_LLM_MAX_TOKENS=1024
JARVIS_LLM_FALLBACK=ollama
JARVIS_LLM_FALLBACK_ENABLED=true
# Legacy/current Ollama settings
LLM_PROVIDER=ollama
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=25
OLLAMA_EMBED_MODEL=nomic-embed-text

# Live Weather (Open-Meteo; no API key required)
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT=10

# Cloud Fallback (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Context & Memory Settings
MAX_CONTEXT_MESSAGES=10
MAX_CONTEXT_CHARS=6000
DATABASE_PATH=data/jarvis.db
DOCUMENTS_DB_PATH=data/documents.db

# Path Security & Workspace
JARVIS_ALLOWED_PATHS=
WORKSPACE_DIR=C:\JARVIS\workspace

# Phase 3 Agent & Action Settings
MAX_PLAN_STEPS=6
MAX_AGENT_STEPS=6
MAX_FILE_SEARCH_RESULTS=20
MAX_WRITE_SIZE_KB=256
ACTION_CONFIRMATION_TTL_SECONDS=300
JARVIS_DRY_RUN=False
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_MAX_STEPS=8
JARVIS_AGENT_MAX_RETRIES=1
JARVIS_AGENT_MAX_RUNTIME_SECONDS=300
JARVIS_AGENT_OBSERVATION_CHARS=6000

# Phase 4 Voice Configuration
JARVIS_VOICE_ENABLED=true
JARVIS_STT_PROVIDER=faster_whisper
JARVIS_STT_MODEL=base
JARVIS_STT_DEVICE=cpu
JARVIS_STT_LANGUAGE=en
JARVIS_STT_BEAM_SIZE=5
JARVIS_STT_TEMPERATURE=0.0
JARVIS_STT_CONDITION_ON_PREVIOUS_TEXT=false
JARVIS_STT_VAD_FILTER=true
JARVIS_STT_VOCABULARY_CATEGORIES=general,programming,projects
JARVIS_STT_CUSTOM_VOCABULARY=
JARVIS_STT_MAX_VOCABULARY_TERMS=64
JARVIS_STT_MAX_HINT_CHARS=1200
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=180
JARVIS_TTS_VOLUME=1.0
JARVIS_SAMPLE_RATE=16000

# Phase 5 Persistent Runtime (wake/tray adapters are optional and local)
JARVIS_WAKE_PROVIDER=disabled
JARVIS_WAKE_PHRASES=hey jarvis,okay jarvis,jarvis
JARVIS_WAKE_WINDOW_SECONDS=2.0
JARVIS_FOLLOW_UP_SECONDS=10.0

# Logging & Environment
LOG_LEVEL=INFO
DEFAULT_EDITOR=code
